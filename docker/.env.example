# ==================================================
# NEXTCLOUD + TRUENAS ENVIRONMENT CONFIGURATION
# ==================================================
# Bu dosya ./setup.sh tarafından otomatik oluşturulabilir
# veya manuel olarak düzenleyip .env olarak kaydedebilirsiniz
# 
# DİKKAT: .env dosyasını version control'e EKLEMEYİN!
# ==================================================

# --------------------------------------------------
# NEXTCLOUD SETTINGS
# --------------------------------------------------

# Admin credentials (CHANGE THESE!)
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD_HERE

# Trusted domains (comma-separated for multiple)
# Examples: localhost, cloud.example.com, 192.168.1.10
NEXTCLOUD_TRUSTED_DOMAINS=localhost,cloud.example.com

# --------------------------------------------------
# DATABASE SETTINGS (PostgreSQL)
# --------------------------------------------------

POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD_HERE

# --------------------------------------------------
# REDIS CACHE SETTINGS
# --------------------------------------------------

# Leave empty for no password (not recommended for production)
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# --------------------------------------------------
# PHP SETTINGS
# --------------------------------------------------

# Memory limit for PHP
PHP_MEMORY_LIMIT=1024M

# Maximum upload size
PHP_UPLOAD_LIMIT=16G

# --------------------------------------------------
# TRUENAS / STORAGE SETTINGS
# --------------------------------------------------

# TrueNAS server IP
TRUENAS_IP=192.168.1.20

# NFS mount points (configured in /etc/fstab)
# These match TrueNAS dataset structure:
#   nextcloud/config   -> /mnt/nextcloud/config
#   nextcloud/data     -> /mnt/nextcloud/data
#
# NOTE: PostgreSQL database is stored locally in Docker volume
# for better performance. NFS is not suitable for database workloads.

NFS_CONFIG_MOUNT=/mnt/nextcloud/config
NFS_DATA_MOUNT=/mnt/nextcloud/data

# --------------------------------------------------
# LARGE DATASET SETTINGS (60TB+)
# --------------------------------------------------

# Enable optimizations for large datasets
LARGE_DATASET=true

# Number of parallel workers for file scanning
INDEX_WORKERS=4

# Batch size for file scanning operations
SCAN_BATCH_SIZE=1000

# --------------------------------------------------
# DOCKER IMAGE TAGS
# --------------------------------------------------

# Nextcloud version
NEXTCLOUD_TAG=29-fpm-alpine

# PostgreSQL version
POSTGRES_TAG=16-alpine

# Redis version
REDIS_TAG=7-alpine

# --------------------------------------------------
# NGINX SETTINGS
# --------------------------------------------------

# HTTP port (change if using NPM on same server)
NGINX_HTTP_PORT=80

# --------------------------------------------------
# SSL SETTINGS (Optional - for manual SSL setup)
# --------------------------------------------------

# Domain for SSL certificate
DOMAIN_NAME=cloud.example.com

# Email for Let's Encrypt notifications
SSL_EMAIL=admin@example.com

# --------------------------------------------------
# OPTIONAL: SMTP SETTINGS (for email notifications)
# --------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=nextcloud@example.com
