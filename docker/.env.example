# ==================================================
# NEXTCLOUD + TRUENAS ENVIRONMENT CONFIGURATION
# ==================================================
# Copy this file to .env and modify the values
# DO NOT commit .env file to version control!
# ==================================================

# --------------------------------------------------
# NEXTCLOUD USER (must match TrueNAS user)
# --------------------------------------------------

# User ID and Group ID for Nextcloud files
# Create a user with this UID on TrueNAS: nextcloud (UID 2000)
NEXTCLOUD_UID=2000
NEXTCLOUD_GID=2000

# --------------------------------------------------
# NEXTCLOUD SETTINGS
# --------------------------------------------------

# Admin credentials (CHANGE THESE!)
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD_HERE

# Trusted domains (comma-separated for multiple)
# Examples: localhost, cloud.example.com, 192.168.1.10
NEXTCLOUD_TRUSTED_DOMAINS=localhost,cloud.example.com

# --------------------------------------------------
# DATABASE SETTINGS (PostgreSQL)
# --------------------------------------------------

POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD_HERE

# --------------------------------------------------
# REDIS CACHE SETTINGS
# --------------------------------------------------

# Leave empty for no password (not recommended for production)
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# --------------------------------------------------
# PHP SETTINGS
# --------------------------------------------------

# Memory limit for PHP
PHP_MEMORY_LIMIT=1024M

# Maximum upload size
PHP_UPLOAD_LIMIT=16G

# --------------------------------------------------
# TRUENAS NFS SETTINGS
# --------------------------------------------------

# TrueNAS server IP
TRUENAS_IP=192.168.1.20

# NFS mount paths (configured in /etc/fstab)
# Data mount: /mnt/nextcloud-data
# Config mount: /mnt/nextcloud-config

# --------------------------------------------------
# SSL SETTINGS
# --------------------------------------------------

# Domain for SSL certificate
SSL_DOMAIN=cloud.example.com

# Email for Let's Encrypt notifications
SSL_EMAIL=admin@example.com

# --------------------------------------------------
# OPTIONAL: SMTP SETTINGS (for email notifications)
# --------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=nextcloud@example.com
